# Copy to .env and set unique values. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
HUB_BIND=127.0.0.1
HUB_PORT=8787
SIMULATION=true
TRANSLATION_PROVIDER=deepl
DEEPL_AUTH_KEY=replace-with-your-deepl-api-key
DEEPL_TIMEOUT_SEC=60
# Quality gate for batch proposals. Passing fields are approved automatically;
# Shopify writes still require the separate /apply request.
QUALITY_AUTO_APPROVE=true
QUALITY_MIN_SCORE=85
QUALITY_MIN_LENGTH_RATIO=0.35
QUALITY_MAX_LENGTH_RATIO=3.0
# DeepL API Free keys end in :fx; Pro keys use the Pro endpoint automatically.
# Shopify integration is not enabled in this pilot scaffold.
